# Copy to .env and fill. NEVER commit .env. Claude cannot read this file (denied in settings.json).
# All NON-SECRET trading config lives in config/trading.yaml — Claude reads/writes that.

# === Questrade OAuth (REQUIRED) ===
# Get an initial refresh token at https://login.questrade.com/APIAccess/UserApps.aspx
# After first `scripts/refresh_token.py` run, the encrypted store has the latest refresh token —
# you can blank this value out then.
QUESTRADE_REFRESH_TOKEN=

# === Token-encryption secret (REQUIRED, 32+ random chars) ===
# Generate via: uv run python scripts/generate_encryption_key.py
# Used to encrypt state/tokens.json.enc at rest. Rotating wipes saved tokens.
TOKEN_ENCRYPTION_KEY=

# === Optional notification channels ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
