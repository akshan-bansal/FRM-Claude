# Copy to .env and fill. NEVER commit .env. Claude cannot read this file (denied in settings.json).
# All NON-SECRET trading config lives in config/trading.yaml — Claude reads/writes that.
#
# IMPORTANT: This is the COMMITTED TEMPLATE. Keep every value BLANK here.
# Put real secrets ONLY in .env (which is gitignored). The app reads .env, never this file.

# === Questrade OAuth (REQUIRED) ===
# Get an initial refresh token at https://login.questrade.com/APIAccess/UserApps.aspx
# After first `scripts/refresh_token.py` run, the encrypted store has the latest refresh token —
# you can blank this value out then.
QUESTRADE_REFRESH_TOKEN=

# === Token-encryption secret (REQUIRED, 32+ random chars) ===
# Generate via: uv run python scripts/generate_encryption_key.py
# Used to encrypt state/tokens.json.enc at rest. Rotating wipes saved tokens.
TOKEN_ENCRYPTION_KEY=

# === Optional notification channels ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# === QuantConnect REST API (optional) ===
# Get these at https://www.quantconnect.com/account (Security -> request via email).
# Used by trading_live_claude.integrations.quantconnect to drive cloud backtests.
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=

# === Kraken private REST API (optional; crypto sleeve) ===
# Create at https://www.kraken.com/u/security/api with the permissions you need
# (Query Funds / Query Orders for read; add Create & Modify Orders only for live trading).
# Public market data (kraken_l2, kraken_ohlc) needs NONE of this — only the future
# KrakenBroker's private endpoints do. Paste the key and the base64 private key below.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# === WorldMonitor OSINT/news MCP (optional; Pro subscription) ===
# Sent as the `X-WorldMonitor-Key` header to https://api.worldmonitor.app/mcp data tools.
# Without it only get_sources works; every statistical/market tool returns "Authentication required".
# Get a key from the WorldMonitor Pro dashboard / their Discord (discord.gg/re63kWKxaz).
# NOTE: the .mcp.json server reads this from the PROCESS environment via ${WORLDMONITOR_API_KEY},
# not from this .env file — see the setup note the assistant gives you.
WORLDMONITOR_API_KEY=
