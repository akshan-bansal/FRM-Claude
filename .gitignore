# Secrets
.env
.env.local
state/tokens.json*
*.pem
*.key

# Local trading config (Claude-managed; not secret but per-machine)
config/trading.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
*.egg-info/
build/
dist/

# Test/coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Data & logs (never commit market data or trade history)
data/cache/
data/*.parquet
data/*.csv
logs/
reports/*.md
# state/ is runtime ground truth (journals, tokens, sentinels): ignore everything except the
# placeholder. An allow-list, so new journals (sizing_decisions.jsonl, *.bak, *.last_wash, STOP_*)
# are never tracked by accident. The old per-file deny-list missed each new one.
state/*
!state/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Notebooks
.ipynb_checkpoints/
data/fundamentals/*.csv

# TradeCard firmware — ESP-IDF build outputs; the wheel only ships src/ Python.
firmware/tradecard/build/
firmware/tradecard/managed_components/
firmware/tradecard/sdkconfig
firmware/tradecard/sdkconfig.old
firmware/tradecard/dependencies.lock

# TradeCard runtime state
state/card_sim/
state/intel_writeups/
state/approval.db
state/approval.db-wal
state/approval.db-shm
