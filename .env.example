# Copy to .env and fill. NEVER commit .env. See scripts/refresh_token.py for first-token bootstrap.

# === Questrade OAuth ===
# Get an initial refresh token at https://login.questrade.com/APIAccess/UserApps.aspx
# Subsequent refreshes are written back to state/tokens.json by the broker layer.
QUESTRADE_REFRESH_TOKEN=
# Set to 'practice' for paper-trading endpoint, 'live' for real account.
QUESTRADE_ENV=practice
# Optional: explicit account number. If empty, broker picks first account at runtime.
QUESTRADE_ACCOUNT_NUMBER=

# === Execution Mode (CRITICAL) ===
# paper | dry-run | live
# Default paper. 'live' also requires CLI --live flag + interactive confirmation.
EXECUTION_MODE=paper

# === Risk Limits (hard gates — applied to every order) ===
RISK_PCT_PER_TRADE=0.01            # Max risk per trade as fraction of equity (1% default)
PORTFOLIO_HEAT_CAP=0.05            # Max total exposure (5% of equity)
DAILY_LOSS_LIMIT_PCT=0.03          # Halt all trading if daily P&L drops by this fraction
MAX_DRAWDOWN_KILL_SWITCH=0.10      # Halt if equity drops 10% from rolling peak
MAX_OPEN_POSITIONS=5               # Hard cap on simultaneous positions
MIN_TICKET_USD=100                 # Skip trades below this notional

# === Strategy / Universe ===
DEFAULT_STRATEGY=ema_crossover
DEFAULT_SYMBOLS=AAPL,MSFT,SHOP.TO,XIC.TO
TIMEZONE=America/Toronto

# === Logging / Storage ===
LOG_LEVEL=INFO
STATE_DIR=state
LOG_DIR=logs
DATA_CACHE_DIR=data/cache

# === Token-encryption secret (random 32+ char string) ===
# Used to encrypt state/tokens.json at rest. Rotating wipes saved tokens.
TOKEN_ENCRYPTION_KEY=

# === Optional notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
